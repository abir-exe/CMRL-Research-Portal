PORT=3001
NODE_ENV=production

# CORS Allowed Origins (Comma-separated list for extra origins beyond default approved domains)
ALLOWED_ORIGINS=https://cmrl.pust.web.app,https://cmrl-pust.web.app,http://localhost:5173

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Firebase Admin SDK Credentials (Matching project: cmrl-research-portal)
FIREBASE_PROJECT_ID=cmrl-research-portal
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@cmrl-research-portal.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
